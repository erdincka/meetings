{
  "uid": "meetings-agents",
  "title": "Agentic Meetings",
  "tags": [
    "meetings",
    "agents",
    "kubernetes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      },
      {
        "name": "profile",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(meetings_turns_total, profile)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "Capability profile"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Least privilege",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "Tool calls refused by the cluster",
      "description": "The headline signal. A non-zero rate means a persona attempted something its capability profile does not permit and the Kubernetes API server refused it. This is enforcement, not a prompt declining.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (profile, tool) (rate(meetings_tool_calls_total{outcome=\"denied\"}[5m]))",
          "legendFormat": "{{profile}} \u00b7 {{tool}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Tool outcomes",
      "description": "denied is a policy decision; error is a fault. They are counted separately on purpose -- collapsing them would let an outage masquerade as a security control working, or hide one that is.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(meetings_tool_calls_total{profile=~\"$profile\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Meeting throughput",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 3,
      "title": "Turn duration by profile (p95)",
      "description": "Wall time for one agent turn, including sandbox acquisition and the model call. Dominated by inference; a jump usually means the model, not the platform.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, profile) (rate(meetings_turn_duration_seconds_bucket{profile=~\"$profile\"}[5m])))",
          "legendFormat": "{{profile}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Turn outcomes",
      "description": "no_sandbox means the warm pool was exhausted -- distinct from a turn that ran and failed.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(meetings_turns_total{profile=~\"$profile\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Sandboxes",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 5,
      "title": "Sandbox acquisition (p95)",
      "description": "A warm claim is sub-second. Seconds means the pool was empty and a turn paid for a cold gVisor pod start, which is exactly what the warm pool exists to prevent -- raise warmReplicas for that profile.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, profile) (rate(meetings_sandbox_acquire_seconds_bucket[5m])))",
          "legendFormat": "{{profile}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Active persona sandboxes",
      "description": "One per attendee per running meeting. Each is a gVisor-isolated pod.",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (profile) (meetings_sandboxes_active)",
          "legendFormat": "{{profile}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "LLM tokens",
      "description": "Consumption by profile and direction.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (profile, direction) (rate(meetings_llm_tokens_total{profile=~\"$profile\"}[5m]))",
          "legendFormat": "{{profile}} \u00b7 {{direction}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
