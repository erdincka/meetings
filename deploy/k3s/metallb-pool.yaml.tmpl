# Real LAN addresses for LoadBalancer Services.
#
# The kind cluster had no LoadBalancer implementation, so the Gateway was
# reached through a fixed NodePort mapped to a host port -- workable, and
# nothing like how ingress works on a real cluster. Here MetalLB hands out
# addresses from the existing subnet and the Gateway is simply browsable.
#
# The range sits above the DHCP pool; adjust if your router's range overlaps.
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: lan
  namespace: metallb-system
spec:
  addresses:
    - ${METALLB_RANGE}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: lan
  namespace: metallb-system
spec:
  ipAddressPools: [lan]
