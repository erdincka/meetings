# Lab cluster configuration.
#
# Copy to lab.env and edit for your network. lab.env is gitignored, so the
# addresses of your machines never end up in the repository -- the values below
# are examples, not defaults that will work anywhere.
#
#   cp deploy/k3s/lab.env.example deploy/k3s/lab.env
#   $EDITOR deploy/k3s/lab.env
#   make cluster-up

# --- Proxmox host ----------------------------------------------------------
PVE_HOST=root@192.0.2.10
PVE_STORAGE=data
PVE_BRIDGE=vmbr0
# VMID of the cloud-init template; created on first run if absent.
PVE_TEMPLATE=9000

# --- network ---------------------------------------------------------------
LAB_SUBNET_PREFIX=192.0.2
LAB_GATEWAY=192.0.2.1
LAB_NETMASK=24

# Cluster nodes. The third is reserved for sandboxes and is tainted.
NODE_CP_IP=192.0.2.30
NODE_W1_IP=192.0.2.31
NODE_W2_IP=192.0.2.32
BUILDER_IP=192.0.2.33

# MetalLB hands out these to LoadBalancer Services. Must sit outside your DHCP
# range or you will get address conflicts that look like random outages.
METALLB_RANGE=192.0.2.240-192.0.2.250
REGISTRY_IP=192.0.2.240
GATEWAY_IP=192.0.2.241

# --- inference -------------------------------------------------------------
# Any OpenAI-compatible endpoint. This example points at Ollama on a
# workstation; start it with `OLLAMA_HOST=0.0.0.0 ollama serve` or the cluster
# cannot reach it.
INFERENCE_HOST=192.0.2.100
INFERENCE_PORT=11434
INFERENCE_MODEL=gemma4:e4b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Sandboxes run default-deny egress and NetworkPolicy matches addresses, not
# names. Anything the inference endpoint resolves to must be listed here, or
# every sandbox turn fails with a bare connection error while the backend --
# which is not sandboxed -- works fine.
INFERENCE_EGRESS_CIDRS=192.0.2.100/32

# --- app -------------------------------------------------------------------
# Hostname the Gateway answers on. Point DNS at GATEWAY_IP, or add a hosts entry.
APP_HOST=meetings.lab
