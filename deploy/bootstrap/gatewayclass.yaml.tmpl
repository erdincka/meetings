# Envoy Gateway installs the Gateway API CRDs and its controller, but does not
# create a GatewayClass -- that is left to the platform owner.
#
# This is precisely what was missing on the k3s cluster this project first ran
# on: the Gateway API CRDs were present (installed by Traefik) but there was no
# GatewayClass and Traefik was never started with --providers.kubernetesgateway,
# so the whole Gateway API surface was inert.
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: envoy
spec:
  controllerName: gateway.envoyproxy.io/gatewayclass-controller
  parametersRef:
    group: gateway.envoyproxy.io
    kind: EnvoyProxy
    name: lan-loadbalancer
    namespace: envoy-gateway-system
---
# The data-plane Service shape.
#
# On the previous kind cluster this pinned a NodePort, because kind has no
# LoadBalancer implementation and the port had to line up with a host port
# mapping. MetalLB assigns a real address from the LAN, so the Gateway is simply
# browsable from any machine on the network and the port-mapping workaround is
# gone.
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: EnvoyProxy
metadata:
  name: lan-loadbalancer
  namespace: envoy-gateway-system
spec:
  provider:
    type: Kubernetes
    kubernetes:
      envoyService:
        type: LoadBalancer
        # Pinned so the address does not move between rebuilds; it must sit
        # inside the MetalLB pool declared in deploy/k3s/metallb-pool.yaml.
        patch:
          type: StrategicMerge
          value:
            spec:
              loadBalancerIP: ${GATEWAY_IP}
