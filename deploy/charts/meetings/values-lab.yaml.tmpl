# The k3s lab cluster on Proxmox.
#
# Images come from the in-cluster registry rather than being side-loaded, so
# pullPolicy is left at the default: content-addressed tags are immutable, and
# a tag that is already present genuinely does not need re-pulling.

image:
  registry: ""
  pullPolicy: IfNotPresent

# Overridden by `make deploy` with content-addressed tags. These defaults exist
# so `helm template` works without a cluster.
backend:
  image: ${REGISTRY_IP}:5000/meetings-backend:latest
frontend:
  image: ${REGISTRY_IP}:5000/meetings-frontend:latest

sandbox:
  runtimeImage: ${REGISTRY_IP}:5000/meetings-persona-runtime:latest
  execImage: ${REGISTRY_IP}:5000/meetings-exec-python:latest
  # Real nodes with their own kernels: gVisor is simply the runtime here, not a
  # four-deep nesting experiment.
  runtimeClassName: gvisor

corpus:
  enabled: true
  image: ${REGISTRY_IP}:5000/meetings-corpus:latest

gateway:
  # MetalLB assigns a real LAN address, so this resolves for anyone on the
  # network. Point a DNS record at the Gateway's IP to use a nicer name.
  host: ${APP_HOST}

inference:
  # Ollama on the development laptop. It has GPU acceleration these 2016-era
  # Xeons do not, so despite far fewer cores it is quicker per token -- at the
  # cost of the demo only working while that machine is on the network.
  #
  # Start it with: OLLAMA_HOST=0.0.0.0 ollama serve
  endpoint: "http://${INFERENCE_HOST}:${INFERENCE_PORT}/v1"
  modelName: "${INFERENCE_MODEL}"
  timeoutSeconds: 300
  embedding:
    endpoint: "http://${INFERENCE_HOST}:${INFERENCE_PORT}/v1"
    modelName: "${EMBEDDING_MODEL}"
    dimensions: ${EMBEDDING_DIMENSIONS}
  # Sandboxes are default-deny egress and NetworkPolicy matches addresses, not
  # names. Without this every sandbox turn fails with a bare connection error
  # while the backend, which is not sandboxed, works fine.
  egressCIDRs:
    - "${INFERENCE_EGRESS_CIDRS}"

logLevel: DEBUG
