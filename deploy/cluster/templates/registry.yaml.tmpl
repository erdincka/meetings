# In-cluster image registry.
#
# Optional, and only for building your own images: a published release is pulled
# from a public registry and needs none of this. Use it for a fork, an air-gapped
# cluster, or an inner loop where pushing to an external registry is the slow
# step.
#
# Plain HTTP, deliberately. It holds nothing secret and TLS would mean
# distributing a CA to every node for no benefit -- but it does mean each node's
# container runtime has to be told to trust it as an insecure mirror, which is a
# host-level change (see install-prerequisites.sh registry). Do not expose this
# outside the cluster network.
apiVersion: v1
kind: Namespace
metadata:
  name: registry
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: registry
  namespace: registry
spec:
  replicas: 1
  selector:
    matchLabels: {app: registry}
  template:
    metadata:
      labels: {app: registry}
    spec:
      containers:
        - name: registry
          image: registry:3
          ports:
            - {name: http, containerPort: 5000}
          env:
            - {name: REGISTRY_STORAGE_DELETE_ENABLED, value: "true"}
          volumeMounts:
            - {name: data, mountPath: /var/lib/registry}
          resources:
            requests: {cpu: 50m, memory: 128Mi}
            limits:   {cpu: "1", memory: 1Gi}
      volumes:
        - name: data
          persistentVolumeClaim: {claimName: registry}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: registry
  namespace: registry
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests: {storage: 50Gi}
---
apiVersion: v1
kind: Service
metadata:
  name: registry
  namespace: registry
spec:
  type: LoadBalancer
  # Pinned so the push URL never changes under you.
  loadBalancerIP: ${REGISTRY_IP}
  selector: {app: registry}
  ports:
    - {name: http, port: 5000, targetPort: http}
