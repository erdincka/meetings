# Envoy Gateway installs the Gateway API CRDs and its controller, but does not
# create a GatewayClass -- that is left to the platform owner.
#
# Worth knowing because of how its absence fails: the CRDs are present,
# `kubectl get gateways` works, and nothing at all is watching. A Gateway API
# surface with no GatewayClass is inert and looks installed, which is why
# `make preflight` checks for one separately.
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: envoy
spec:
  controllerName: gateway.envoyproxy.io/gatewayclass-controller
  parametersRef:
    group: gateway.envoyproxy.io
    kind: EnvoyProxy
    name: lan-loadbalancer
    namespace: envoy-gateway-system
---
# The data-plane Service shape.
#
# A LoadBalancer with a pinned address, so the app has a stable URL. On a cluster
# with no LoadBalancer implementation, change the type to NodePort here (or
# install MetalLB) -- nothing else in the chart depends on which it is.
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: EnvoyProxy
metadata:
  name: lan-loadbalancer
  namespace: envoy-gateway-system
spec:
  provider:
    type: Kubernetes
    kubernetes:
      envoyService:
        type: LoadBalancer
        # Pinned so the address does not move between rebuilds. It must sit
        # inside whatever pool your LoadBalancer allocates from -- with MetalLB,
        # the one in deploy/cluster/templates/metallb-pool.yaml.
        patch:
          type: StrategicMerge
          value:
            spec:
              loadBalancerIP: ${GATEWAY_IP}
