# Deployment settings for your cluster.
#
#   cp deploy/cluster/cluster.env.example deploy/cluster/cluster.env
#   $EDITOR deploy/cluster/cluster.env
#   make preflight
#
# cluster.env is gitignored: the addresses of your machines and the location of
# your model endpoint are yours, not the repository's. The values below are
# RFC 5737 documentation addresses and will not work anywhere unedited — that is
# deliberate, because a default that half-works is harder to debug than one that
# fails immediately.

# --- images ----------------------------------------------------------------
# Where the five images are pulled from. Two supported shapes:
#
#   ghcr.io/<owner>          published, signed images -- verify them first with
#                            `make verify-images`
#   <address>:5000           a registry inside your own cluster, for images you
#                            build yourself
#
# Leave IMAGE_TAG at a release tag for published images; `make images` overrides
# it with content-addressed tags when you build your own.
IMAGE_REGISTRY=ghcr.io/erdincka
IMAGE_TAG=latest

# --- application -----------------------------------------------------------
# The DNS domain the deployment lives under. Two names are derived from it and
# served by one Gateway on one address:
#
#   meetings.${APP_DOMAIN}   the app
#   grafana.${APP_DOMAIN}    Grafana, when OBSERVABILITY_ENABLED=true
#
# Create two A records pointing at the Gateway address, or one wildcard record
# for *.${APP_DOMAIN}. A domain rather than two independent hostnames because
# they always resolved to the same address anyway, and keeping them separate
# only created a way for them to disagree.
APP_DOMAIN=example.com

# The RuntimeClass that runs sandboxes under a kernel boundary. `gvisor` on any
# cluster where runsc is installed; see docs/requirements.md for the fallbacks
# and what each one gives up.
SANDBOX_RUNTIME_CLASS=gvisor

# --- observability ---------------------------------------------------------
# Scraping, tracing, and the Grafana listener on the Gateway, all from one
# setting. `make observability` installs the stack this points at; without it
# these are inert rather than broken.
#
# This used to be decided by which make target you ran -- `make deploy-observed`
# turned scraping and tracing on, and a later plain `make deploy` silently
# turned them back off, taking the ServiceMonitor and every dashboard panel with
# it. Configuration decides it now, so the two commands cannot disagree.
OBSERVABILITY_ENABLED=false

# --- inference -------------------------------------------------------------
# Any OpenAI-compatible endpoint: a hosted provider (OpenAI, OpenRouter,
# Together), a self-hosted vLLM, or Ollama on your own machine (start it with
# `OLLAMA_HOST=0.0.0.0 ollama serve`, or the cluster cannot reach it).
#
# Only the backend talks to this. Persona sandboxes reach the model through the
# backend and have no route off the cluster at all, so a hosted endpoint behind
# a CDN needs no address list and no egress rule -- see docs/architecture.md.
INFERENCE_ENDPOINT=https://openrouter.ai/api/v1
INFERENCE_MODEL=meta-llama/llama-3.3-70b-instruct
EMBEDDING_ENDPOINT=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Reasoning effort, per provider. Empty means "send nothing", which is the only
# portable choice: Ollama accepts "none", OpenAI-style providers take
# low/medium/high and reject "none", and a value the provider merely tolerates
# can still break structured output silently.
#
# The chair is the sensitive one. It makes a single bounded structured-output
# call, and a provider that spends that budget thinking returns a tool call that
# never parses -- the meeting then ends at turn 0 with nothing in an error state.
INFERENCE_REASONING_EFFORT=
SUPERVISOR_REASONING_EFFORT=

# Credentials for the endpoints above. Leave empty for a local provider that
# accepts none. These are written into the `meetings-runtime` Secret by
# `make deploy` and never passed through Helm values, so they stay out of
# `helm get values` and out of the release Secret.
#
# cluster.env is gitignored, but it is still a file with a key in it: prefer
# `INFERENCE_API_KEY=$(cat ~/.config/openrouter-key)` in your shell over
# committing to your own habits.
INFERENCE_API_KEY=
EMBEDDING_API_KEY=

# --- optional: HTTPS -------------------------------------------------------
# Off by default, and nothing below is a prerequisite for deploying. Plain HTTP
# against a hostname on your own network needs no domain, no registrar and no
# certificate authority, and that path stays fully supported.
#
# Turn it on when APP_HOST is a name you actually own. Two ways to fill the
# certificate Secret:
#
#   APP_TLS_SECRET     a Secret you create yourself, in the meetings namespace:
#                        kubectl -n meetings create secret tls meetings-tls \
#                          --cert=fullchain.pem --key=privkey.pem
#   APP_TLS_ISSUER     a cert-manager Issuer that fills it for you. Needs
#                      cert-manager running with --enable-gateway-api, which is
#                      not its default.
#
# If APP_HOST resolves to a private address -- and it does whenever the Gateway
# sits on your LAN, whatever the domain is registered as -- the issuer must use
# a dns01 solver. http01 asks Let's Encrypt to open a connection *to* the name,
# and it cannot route to RFC 1918 space. This is a property of the ClusterIssuer
# you point at, not of anything here.
APP_TLS_ENABLED=false
APP_TLS_SECRET=
APP_TLS_ISSUER=
APP_TLS_ISSUER_KIND=ClusterIssuer
# Send :80 to :443. Leave this off until the certificate is trusted: a redirect
# to a certificate nothing accepts turns a working deployment into an
# unreachable one, and the browser blames the certificate, not the redirect.
APP_TLS_REDIRECT=false


# --- optional: cluster prerequisites ---------------------------------------
# Only read by deploy/cluster/install-prerequisites.sh, and only for the
# components you ask it to install. Ignore them if your cluster already has a
# LoadBalancer implementation and you pull images from a registry it can reach.

# MetalLB address pool, for a bare-metal cluster with no LoadBalancer. Must sit
# outside your DHCP range: an overlap produces address conflicts that present as
# intermittent, unexplained outages rather than as anything network-shaped.
METALLB_RANGE=192.0.2.240-192.0.2.250
# Fixed addresses inside that pool, so the push URL and the app URL do not move.
REGISTRY_IP=192.0.2.240
GATEWAY_IP=192.0.2.241

# --- optional: building your own images ------------------------------------
# An SSH destination with Docker on it, used by `make images`: the tree is
# rsynced there and built natively. That beats emulation by enough to matter in
# an inner loop when your workstation and your nodes differ in architecture.
# Leave empty to build locally instead.
#
# An ssh destination, not a Docker host URL -- `user@host` or a Host alias from
# ~/.ssh/config. `ssh://user@host` is accepted and stripped, but a port belongs
# in ~/.ssh/config: rsync has no way to take one here.
BUILDER=
BUILDER_DIR=/home/ubuntu/meetings
