# Local development. Copy to .env; .env is gitignored.
#
# NOTE: as of Phase 1 the backend no longer reads credentials from a plaintext
# config.json on a PVC -- they come from the `meetings-runtime` Kubernetes
# Secret. These values are for host-side tooling and `helm upgrade` only.

KUBE_CONTEXT=kind-meetings
NAMESPACE=meetings

# Inference: mode is `external` (any OpenAI-compatible endpoint) or `ollama`.
INFERENCE_MODE=external
INFERENCE_ENDPOINT=
INFERENCE_API_KEY=
INFERENCE_MODEL_NAME=

EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=
