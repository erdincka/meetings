# Local development. Copy to .env; .env is gitignored.
#
# Credentials reach the running app through the `meetings-runtime` Kubernetes
# Secret, not this file. These values are for host-side tooling -- migrations,
# scripts, and running the backend outside the cluster.

KUBE_CONTEXT=kind-meetings
NAMESPACE=meetings

# Any OpenAI-compatible endpoint. The default assumes Ollama on this machine,
# started with `OLLAMA_HOST=0.0.0.0 ollama serve` so the cluster can reach it.
# Local providers need no credentials, so the keys may be left empty.
INFERENCE_ENDPOINT=http://localhost:11434/v1
INFERENCE_MODEL_NAME=gemma4:e4b
INFERENCE_API_KEY=

EMBEDDING_ENDPOINT=http://localhost:11434/v1
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_API_KEY=
